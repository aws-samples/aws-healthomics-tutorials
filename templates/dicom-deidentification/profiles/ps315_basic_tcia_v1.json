  "_options_layered": [
    "Retain Modified Longitudinal Temporal Information",
    "Retain Patient Characteristics",
    "Retain Device Identity"
  ],

  "_NOTE_salt": "The operator MUST replace 'REPLACE_ME' with a project-specific salt before submitting this profile.  The same salt deterministically maps source identifiers to the same de-identified values across runs.  Do not commit a real salt to source control.",
  "salt": "REPLACE_ME",

  "drop_private_tags": true,
  "replace_uids": true,
  "max_date_shift_days": 365,

  "enable_pixel_text_detection": true,
  "enable_pixel_masking": true,
  "mask_lossy_images": true,
  "unmatched_text_policy": "mask",
  "allow_unsupported_pixel_ts": false,
  "enable_clahe": true,
  "clahe_clip_limit": 2.0,
  "ocr_upscale_factor": 2,

  "_NOTE_execution": "Instances are processed in a single Python process (OCR weights load once).  inline_checkpoint_every flushes a partial manifest every N instances so a C-level crash on retry doesn't lose all prior work.",
  "inline_checkpoint_every": 50,

